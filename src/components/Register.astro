<section id="register" class="relative py-20 bg-gradient-to-b from-[#0a0a0a] to-[#111]">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
    <div class="rounded-2xl border border-white/10 bg-white/5 p-8 sm:p-12 hover:border-white/20 hover:bg-white/[0.07] transition-all">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Ready to Hack?
      </h2>
      <p class="text-lg text-slate-400 mb-8 max-w-xl mx-auto">
        Join 100+ students for an unforgettable weekend of coding, learning, and building. No experience needed – just bring your curiosity!
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a 
          href="/register" 
          class="rounded-lg border border-white bg-white px-8 py-4 text-lg font-semibold text-black hover:bg-white/90 hover:shadow-[0_0_30px_rgba(255,255,255,0.3)] hover:scale-105 transition-all text-center w-full sm:w-auto"
        >
          Register Now
        </a>
        <a 
          href="https://discord.gg/7KQtGmTJ" 
          target="_blank" 
          rel="noreferrer"
          class="rounded-lg border border-white/20 bg-white/5 px-8 py-4 text-lg font-semibold text-white hover:bg-white/10 hover:shadow-[0_0_30px_rgba(255,255,255,0.15)] hover:border-white/40 hover:scale-105 transition-all text-center w-full sm:w-auto"
        >
          Join Discord
        </a>
      </div>
      
      <p class="mt-6 text-sm text-slate-500">
        Registration is free and open to all high school students
      </p>
    </div>
  </div>
</section>
